# Zmienne środowiskowe dla serwera MCP

# Adres URL API aplikacji webowej, z którym będzie się łączył serwer MCP.
# Wewnątrz sieci Docker Compose używamy nazwy serwisu i wewnętrznego portu.
API_URL="http://webapp:8080/api"

# Port, na którym serwer MCP będzie nasłuchiwał wewnątrz kontenera.
# Wartość ta powinna być zgodna z ENV PORT w mcp-server/Dockerfile
PORT=8081
