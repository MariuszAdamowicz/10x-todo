---
import Layout from '@/layouts/Layout.astro';
import { ProjectService } from '@/lib/services/project.service';
import ProjectSettingsView from '@/components/views/ProjectSettingsView';

export const prerender = false;

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/projects');
}

const projectService = new ProjectService();
let project = null;
let error = null;

try {
  project = await projectService.getProjectById(Astro.locals.supabase, id, Astro.locals.user.id);
} catch (e) {
  error = e;
}

console.log("Project in settings.astro:", project);
console.log("Error in settings.astro:", error);

if (error) {
  // TODO: Obsługa błędów (np. przekierowanie na stronę błędu)
  console.error(error);
  return Astro.redirect('/projects');
}

if (!project) {
  return Astro.redirect('/404');
}
---

<Layout title=`Settings for ${project.name}`>
  <ProjectSettingsView initialProject={project} client:load />
</Layout>
