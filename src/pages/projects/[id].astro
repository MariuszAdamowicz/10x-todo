---
/* eslint-disable no-console */
import { ProjectAndTasksView } from "@/components/features/tasks/ProjectAndTasksView";
import Layout from "@/layouts/Layout.astro";
import { ProjectService } from "@/lib/services/project.service";
import { TaskService } from "@/lib/services/task.service";
import type { IBreadcrumb, Project, Task } from "@/types";
import { createSupabaseServer } from "@/db/supabase.client";

export const prerender = false;

const { id: projectId } = Astro.params;
const { user } = Astro.locals;

// This page requires a logged-in user
if (!user) {
  return Astro.redirect("/login");
}

// This page requires a project ID
if (!projectId) {
  return Astro.redirect("/projects");
}

const supabase = createSupabaseServer({ cookies: Astro.cookies, headers: Astro.request.headers });
const projectService = new ProjectService(supabase);
const taskService = new TaskService(supabase);

let project: Project | null = null;
let initialTasks: Task[] = [];
let breadcrumbs: IBreadcrumb[] = [];
let error: Error | null = null;

try {
  const [projectResult, tasksResult, breadcrumbsResult] = await Promise.all([
    projectService.getProjectById(projectId, user.id),
    taskService.getTasks({
      filters: { projectId: projectId, parentId: null },
      pagination: { page: 1, limit: 100 }, // TODO: Implement real pagination
      auth: { userId: user.id },
    }),
    taskService.getBreadcrumbs(projectId, undefined, supabase),
  ]);

  project = projectResult;
  initialTasks = tasksResult.data;
  breadcrumbs = breadcrumbsResult;
} catch (e) {
  error = e instanceof Error ? e : new Error("An unknown error occurred");
  // In dev, show the full error. In prod, you might want a generic message.
  if (import.meta.env.DEV) {
    console.error(e);
  }
}

// Redirect if the project is not found or there was a critical error
if (!project) {
  // TODO: Add a user-facing error message to the page it redirects to (e.g., via a query param)
  return Astro.redirect("/projects");
}
---

<Layout title={project.name}>
  <ProjectAndTasksView
    project={project}
    initialTasks={initialTasks}
    breadcrumbs={breadcrumbs}
    parentTask={null}
    client:load
  />
  <!-- TODO: Add a proper error display component -->
  {error && <p class="text-red-500 p-4 text-center">Error loading project data: {error.message}</p>}
</Layout>
